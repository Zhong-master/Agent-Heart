// installer/setup.rc —— Setup.exe 图标与版本信息
#include <windows.h>
#pragma code_page(65001)

// 图标来自项目 assets\\wallpaper.ico(rc 位于 installer\\,相对路径上一级)
IDI_APPICON ICON "..\\assets\\wallpaper.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "Agent-Heart"
            VALUE "FileDescription", "Agent-Heart 安装程序"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "Setup"
            VALUE "OriginalFilename", "Setup.exe"
            VALUE "ProductName", "Agent-Heart 安装程序"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
